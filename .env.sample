# App
NODE_ENV=development
PORT=5000

# MongoDB
LOCAL_DB=mongodb://localhost:27017/ayyo
DB=

# JWT
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# Email (Gmail via Nodemailer)
EMAIL=
PASSWORD=

# Public URLs used in emailed links
BASE_URL=http://localhost:5000
BASE_URL_PROD=

# Comma-separated list of allowed CORS origins (leave unset to allow all, useful for local dev)
ALLOWED_ORIGINS=

# Package expiry, in days
PACKAGE_EXPIRY_DAYS=7

# Redis (used by Bull queues)
REDIS_URL=redis://localhost:6379

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
